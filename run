#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for claude-mem-terminal-title development.
#

set -o nounset
set -o pipefail
set -o errexit

# Change the current directory to the project root.
PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

################################################################################
# Helper Functions

function _bun {
  command -v bun || echo "$HOME/.bun/bin/bun"
}

################################################################################
# Setup Commands

function deps {
  #@ Install dependencies and check required tooling
  #@ Category: Setup
  local ok=0
  local bun_bin
  bun_bin=$(_bun)
  if [[ -x $bun_bin ]]; then
    echo "bun: $("$bun_bin" --version) ($bun_bin)"
  else
    echo "bun: MISSING (install from https://bun.sh)"
    return 1
  fi
  echo "installing dependencies..."
  "$bun_bin" install
  if command -v claude >/dev/null 2>&1; then
    echo "claude: $(claude --version 2>/dev/null || echo present) (Claude Code >= 2.1.141; also the summarizer's subscription auth)"
  else
    echo "claude: NOT FOUND on PATH (required for terminalSequence and for the summarizer's auth)"
    ok=1
  fi
  return $ok
}

function doctor {
  #@ Verify the claude CLI, the Agent SDK, and a live topic generation
  #@ Category: Setup
  "$(_bun)" "$PROJECT_ROOT/hooks/doctor.mjs"
}

function install {
  #@ Install the Stop hook into Claude Code's settings.json
  #@ Category: Setup
  "$(_bun)" "$PROJECT_ROOT/hooks/configure.mjs" install
}

function uninstall {
  #@ Remove the Stop hook from Claude Code's settings.json
  #@ Category: Setup
  "$(_bun)" "$PROJECT_ROOT/hooks/configure.mjs" uninstall
}

################################################################################
# Quality Commands

function test {
  #@ Run the test suite
  #@ Category: Quality
  "$(_bun)" test
}

################################################################################
# Core Commands

function help {
  #@ Show this help message
  #@ Category: Core
  echo "claude-mem-terminal-title - Development Commands"
  echo "================================================"
  echo ""
  echo "Available commands:"
  echo ""

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n" cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "  %-25s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
  echo ""
}

################################################################################
# Commands end.

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
